GRAMPS_BASE_URL=https://gramps.example.com
GRAMPS_USERNAME=mcp-automation
GRAMPS_PASSWORD=changeme

# Destructive tools (gramps_delete_person, gramps_delete_family,
# gramps_delete_blog_post, gramps_delete_all_objects) are OFF by default and are
# not even registered. Set to 1 to opt in; the account then also needs delete
# rights on the tree. Leave unset for a read/edit-only deployment.
#
# Note what the fourth one is before you opt in: gramps_delete_all_objects empties
# the ENTIRE tree and cannot be undone. It additionally requires OWNER role, plus
# confirm=True and an expected_count matching the tree's live total — but this
# variable is what decides whether it exists at all. Export first
# (gramps_export_tree); a wipe is only as recoverable as your last backup.
# GRAMPS_ENABLE_DESTRUCTIVE=1

# Blog post body format: "html" stores post bodies as HTML (rendered + sanitized
# by the server); anything else (default) stores plain text. Only the exact
# value "html" enables HTML.
GRAMPS_BLOG_BODY_FORMAT=text

# Backup directory (inside the container) for the backup/restore tools.
# gramps_export_tree writes backups here; gramps_import_file reads files from here.
# Mount a host directory to this path and set GRAMPS_BACKUP_DIR to it, e.g.
#   docker run ... -v /path/on/host/export:/data ... and GRAMPS_BACKUP_DIR=/data
# Import additionally requires the account to have OWNER role (see README).
# GRAMPS_BACKUP_DIR=/data
