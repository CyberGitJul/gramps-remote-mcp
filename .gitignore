# Secrets / local environment — never commit real credentials
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# CodeGraph local index — not part of the public repo
.codegraph/

# Local working notes — not part of the public repo
PROGRESS.md
HANDOFF-*.md
docs/Progress_archive.md

# Claude Code: share the project knowledge (rules, skills), keep the runtime state out.
# Must be `.claude/*` rather than `.claude/` — git does not descend into an ignored
# directory, so the negations below would never be evaluated.
.claude/*
!.claude/rules/
!.claude/skills/
.instance/

# Coverage artifacts
.coverage
coverage.xml
htmlcov/

# E2E run artifacts (per-run backup dirs, exports, logs) — regenerated by every probe run
.e2e-artifacts/
